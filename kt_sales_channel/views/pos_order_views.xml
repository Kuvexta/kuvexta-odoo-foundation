<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Ancla verificada contra addons/point_of_sale/views/pos_order_view.xml
         (rama 19.0): group[@name='order_fields']/field[@name='partner_id']. -->
    <record id="view_pos_pos_form_kt_sales_channel" model="ir.ui.view">
        <field name="name">pos.order.form.kt.sales.channel</field>
        <field name="model">pos.order</field>
        <field name="mode">extension</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_pos_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='order_fields']/field[@name='partner_id']"
                   position="after">
                <field name="kt_sales_channel_id"
                       options="{'no_create': True}"/>
            </xpath>
        </field>
    </record>

    <record id="view_pos_order_tree_kt_sales_channel" model="ir.ui.view">
        <field name="name">pos.order.list.kt.sales.channel</field>
        <field name="model">pos.order</field>
        <field name="mode">extension</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_order_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="kt_sales_channel_id" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
