<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_product_label_layout_form_kt_public_qr" model="ir.ui.view">
        <field name="name">product.label.layout.form.kt.public.qr</field>
        <field name="model">product.label.layout</field>
        <field name="inherit_id" ref="product.product_label_layout_form"/>
        <field name="arch" type="xml">
            <field name="print_format" position="after">
                <field name="kt_label_size_id"
                       invisible="print_format != 'kt_public_qr_custom'"
                       required="print_format == 'kt_public_qr_custom'"/>
            </field>
        </field>
    </record>

</odoo>
