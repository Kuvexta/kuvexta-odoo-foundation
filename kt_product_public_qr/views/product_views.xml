<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Botón y campos del QR agrupador en la ficha de PLANTILLA de
         producto. Se ancla junto al botón nativo "Documentos" (mismo
         patrón usado en kt_product_multi_barcode) para máxima
         compatibilidad entre versiones de Odoo 19. -->
    <record id="view_product_template_form_public_qr" model="ir.ui.view">
        <field name="name">product.template.form.public.qr</field>
        <field name="model">product.template</field>
        <field name="mode">extension</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_open_documents']" position="before">
                <button name="action_open_kt_public_page" type="object"
                        class="oe_stat_button" icon="fa-qrcode"
                        string="Página pública">
                </button>
            </xpath>
            <notebook position="inside">
                <page string="QR público" name="kt_public_qr">
                    <group>
                        <field name="kt_public_website_id"
                               groups="website.group_multi_website"/>
                        <field name="kt_public_qr_url" widget="url" readonly="1"
                               string="Enlace público (QR agrupador)"/>
                    </group>
                    <button name="action_kt_regenerate_public_token"
                            type="object"
                            string="Regenerar enlace público"
                            icon="fa-refresh"
                            confirm="El enlace/QR público ANTERIOR dejará de funcionar de inmediato. Cualquier etiqueta ya impresa con el código viejo quedará inválida y deberá reimprimirse. ¿Continuar?"
                            help="Use esto si el enlace se compartió o filtró por error. Genera un enlace/token nuevo e invalida el anterior al instante."/>
                </page>
            </notebook>
        </field>
    </record>
</odoo>
