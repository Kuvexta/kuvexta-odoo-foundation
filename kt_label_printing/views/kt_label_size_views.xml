<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_kt_label_size_list" model="ir.ui.view">
        <field name="name">kt.label.size.list</field>
        <field name="model">kt.label.size</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="label_width_mm"/>
                <field name="label_height_mm"/>
                <field name="content_size_mm"/>
                <field name="columns"/>
                <field name="rows"/>
            </list>
        </field>
    </record>

    <record id="view_kt_label_size_form" model="ir.ui.view">
        <field name="name">kt.label.size.form</field>
        <field name="model">kt.label.size</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                    <group string="Tamaño de la etiqueta">
                        <field name="label_width_mm"/>
                        <field name="label_height_mm"/>
                        <field name="content_size_mm"/>
                    </group>
                    <group string="Tamaño de la hoja/rollo">
                        <field name="page_width_mm"/>
                        <field name="page_height_mm"/>
                        <field name="margin_mm"/>
                    </group>
                    <group string="Resultado calculado">
                        <field name="columns" readonly="1"/>
                        <field name="rows" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_kt_label_size" model="ir.actions.act_window">
        <field name="name">Tamaños de etiqueta</field>
        <field name="res_model">kt.label.size</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_kt_label_size"
              name="Tamaños de etiqueta"
              action="action_kt_label_size"
              parent="stock.menu_stock_inventory_control"
              sequence="50"/>

</odoo>
